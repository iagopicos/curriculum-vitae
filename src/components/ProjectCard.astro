---
import Badge from "@/components/Badge.astro";
import { getLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLang(Astro.currentLocale));

interface Props {
    name: string;
    description: string;
    tags: string[];
    repo?: string;
    site?: string;
}

const { name, description, tags, repo, site } = Astro.props;
---

<article class="project-card">
    <h3 class="t-item">{name}</h3>
    <p class="t-body-sm c-muted">{description}</p>

    <div class="badges">
        {tags.map((tag) => (
            <Badge label={tag} />
        ))}
    </div>
    {(repo || site) && (
        <div class="links">
            {site && (
                <a
                    href={site}
                    class="t-mono-sm c-accent"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t("project.site")}
                </a>
            )}
            {repo && (
                <a
                    href={repo}
                    class="t-mono-sm c-accent"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t("project.repo")}
                </a>
            )}
        </div>
    )}
</article>

<style lang="scss">
    .project-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-12);
        padding: var(--space-24);
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
    }
    .project-card a {
        margin-top: auto;
    }

    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8);
    }
    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-16);
        margin-top: auto;
    }
</style>
