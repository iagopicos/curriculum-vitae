---
interface Props {
    num: number;
    title: string;
}
const { num, title } = Astro.props;
const label = String(num).padStart(2, "0");
---

<div class="section-title">
    <span class="t-mono-sm c-accent">// {label}</span>
    <h2 class="t-section">{title}</h2>
</div>
<style lang="scss">
    .section-title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-8);
    }
</style>
