---
import { getCollection } from "astro:content";
import SectionTitle from "@/components/SectionTitle.astro";
import ExperienceItem from "@/components/ExperienceItem.astro";
import { getLang, useTranslations } from "@/i18n/utils";
import { formatPeriod } from "@/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = await getCollection("experience");
entries.sort((a, b) => b.data.start - a.data.start);

const jobs = entries.map((entry) => ({
    date: formatPeriod(
        entry.data.start,
        entry.data.end,
        t("experience.present"),
    ),
    role: entry.data.role[lang],
    company: entry.data.company,
    location: entry.data.location[lang],
    highlights: entry.data.highlights.map((h) => h[lang]),
    tags: entry.data.tags,
}));
---

<section id="experience" class="experience container">
    <SectionTitle num={2} title={t("section.experience")} />
    <div class="timeline">
        {jobs.map((job) => (
            <ExperienceItem {...job} />
        ))}
    </div>
</section>

<style lang="scss">
    @use "../../styles/_mixins.scss" as *;
    .experience {
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
        padding-top: var(--space-96);
    }
    .timeline {
        display: flex;
        flex-direction: column;
    }
</style>
