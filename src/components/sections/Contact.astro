---
import SectionTitle from "@/components/SectionTitle.astro";
import Button from "@/components/Button.astro";

const email = "iagopicosdeveloper@gmail.com";
import { getLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLang(Astro.currentLocale));
---

<section id="contacto" class="contact container">
    <SectionTitle num={5} title={t("section.contact")} />

    <div class="contact-body">
        <p class="t-body-lg c-muted">
            ¿Tienes un proyecto o una vacante interesante? Escríbeme y hablamos.
        </p>

        <a href={`mailto:${email}`} class="email t-section c-accent">
            {email}
        </a>

        <div class="contact-links">
            <Button label="GitHub" href="https://github.com" type="secondary" />
            <Button
                label="LinkedIn"
                href="https://linkedin.com"
                type="secondary"
            />
        </div>
    </div>
</section>

<style lang="scss">
    @use "../../styles/mixins" as *;

    .contact {
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
        padding-block: var(--space-96);
    }

    .contact-body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-24);
    }

    .email {
        overflow-wrap: anywhere;

        @include mobile {
            font-size: 20px;
        }
    }

    .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-12);
    }
</style>
