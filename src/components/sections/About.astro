---
import { getEntry } from "astro:content";
import SectionTitle from "@/components/SectionTitle.astro";
import { getLang, useTranslations } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const about = await getEntry("about", "main");
if (!about)
    throw new Error("Falta la entrada 'main' en src/content/about.yaml");

const paragraphs = about.data.paragraphs.map((p) => p[lang]);
const facts = about.data.facts.map((fact) => ({
    label: fact.label[lang],
    value: fact.value[lang],
}));
---

<section id="sobre-mi" class="about container">
    <SectionTitle num={1} title={t("section.about")} />

    <div class="about-content">
        <div class="about-text">
            {paragraphs.map((p) => (
                <p class="t-body c-muted">{p}</p>
            ))}
        </div>

        <dl class="about-facts">
            {facts.map((fact) => (
                <div class="fact">
                    <dt class="t-mono-sm c-muted">{fact.label}</dt>
                    <dd class="t-item">{fact.value}</dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style lang="scss">
    @use "../../styles/mixins" as *;

    .about {
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
        padding-top: var(--space-96);
    }

    .about-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--space-32);

        @include mobile {
            flex-direction: column;
        }
    }

    .about-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
        max-width: 640px;
    }

    .about-facts {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
    }

    .fact {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }
</style>
