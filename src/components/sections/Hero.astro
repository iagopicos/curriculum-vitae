---
import Button from "../Button.astro";
import { getLang, useTranslations } from "@/i18n/utils";
import { site } from "@/config/site";
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cvPdf = `/cv/iago-fernandez-picos-cv-${lang}.pdf`;
---

<section class="hero container">
    <div class="intro">
        <p class="t-mono c-accent">$ whoami</p>
        <h1 class="t-hero">{site.name}</h1>
        <p class="t-body-lg c-muted">{t("hero.subtitle")}</p>
    </div>

    <div class="actions">
        <Button label={t("hero.cta")} href="#experiencia" />
        <Button label={t("hero.donwloadCv")} href={cvPdf} type="secondary" />
        <Button label="GitHub" href={site.github} type="secondary" />
        <Button label="LinkedIn" href={site.linkedin} type="secondary" />
    </div>
</section>

<style lang="scss">
    .hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--space-32);
        min-height: calc(100svh - 54px);
    }

    .intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-12);
    }
</style>
