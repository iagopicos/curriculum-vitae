---
import { getLang, useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

interface NavLink {
    href: string;
    label: string;
}
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const links: NavLink[] = [
    { href: "#sobre-mi", label: t("nav.about") },
    { href: "#experience", label: t("nav.experience") },
    { href: "#projects", label: t("nav.projects") },
    { href: "#contacto", label: t("nav.contact") },
];
const languages = [
    { code: "es", label: "Español", href: getRelativeLocaleUrl("es") },
    { code: "en", label: "English", href: getRelativeLocaleUrl("en") },
];
---

<header class="header">
    <nav class="nav container">
        <a href="#" class="t-mono">
            iago<span class="c-accent">.dev</span>
        </a>
        <div class="nav-right">
            <ul class="links">
                {links.map((link) => (
                    <li>
                        <a href={link.href} class="t-body-sm">
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
            <details class="lang-menu">
                <summary
                    class="t-mono-sm"
                    aria-label={`${t("nav.language")}: ${lang}`}
                >
                    {lang}
                    <span class="chevron" aria-hidden="true">
                        ▾
                    </span>
                </summary>

                <ul class="lang-options">
                    {languages.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                hreflang={l.code}
                                lang={l.code}
                                aria-current={
                                    l.code === lang ? "page" : undefined
                                }
                                class="t-body-sm"
                            >
                                {l.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
            <button
                class="menu-button"
                type="button"
                aria-label={t("nav.openMenu")}
                aria-controls="mobile-menu"
                aria-expanded="false"
            >
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M4 7h16M4 12h16M4 17h16"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    />
                </svg>
            </button>
        </div>
    </nav>
    <dialog id="mobile-menu" class="mobile-menu" aria-label={t("nav.menu")}>
        <div class="mobile-menu-header">
            <span class="t-mono">
                iago<span class="c-accent">.dev</span>
            </span>
            <button
                class="menu-close"
                type="button"
                aria-label={t("nav.closeMenu")}
            >
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M6 6l12 12M18 6L6 18"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    />
                </svg>
            </button>
        </div>

        <ul class="mobile-links">
            {links.map((link) => (
                <li>
                    <a href={link.href} class="t-section">
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </dialog>
</header>

<script>
    const menu = document.querySelector<HTMLDetailsElement>(".lang-menu");

    const mobileMenu =
        document.querySelector<HTMLDialogElement>("#mobile-menu");
    const menuButton =
        document.querySelector<HTMLButtonElement>(".menu-button");
    const menuClose =
        mobileMenu?.querySelector<HTMLButtonElement>(".menu-close");
    document.addEventListener("click", (event) => {
        if (menu?.open && !menu.contains(event.target as Node)) {
            menu.open = false;
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.open) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
        }
    });

    menuButton?.addEventListener("click", () => {
        mobileMenu?.showModal();
        menuButton.setAttribute("aria-expanded", "true");
    });

    menuClose?.addEventListener("click", () => mobileMenu?.close());

    mobileMenu?.addEventListener("close", () => {
        menuButton?.setAttribute("aria-expanded", "false");
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => mobileMenu.close());
    });
</script>

<style lang="scss">
    @use "../styles/mixins" as *;

    .header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg-base);
        border-bottom: 1px solid var(--border-default);
    }

    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-block: var(--space-16);
    }
    .nav-right {
        display: flex;
        align-items: center;
        gap: var(--space-24);
    }

    .lang-menu {
        position: relative;

        summary {
            display: flex;
            align-items: center;
            gap: var(--space-4);
            color: var(--text-muted);
            text-transform: uppercase;
            cursor: pointer;
            list-style: none;
            transition: color 0.2s;

            &::-webkit-details-marker {
                display: none;
            }

            &:hover {
                color: var(--text-primary);
            }
        }

        &[open] .chevron {
            rotate: 180deg;
        }
    }

    .lang-options {
        position: absolute;
        top: calc(100% + var(--space-8));
        right: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        min-width: 140px;
        margin: 0;
        padding: var(--space-8);
        list-style: none;
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);

        a {
            display: block;
            padding: var(--space-8) var(--space-12);
            border-radius: var(--radius-sm);
            color: var(--text-muted);

            &:hover {
                background: var(--border-default);
                color: var(--text-primary);
            }

            &[aria-current] {
                color: var(--accent-default);
            }
        }
    }
    .links {
        display: flex;
        gap: var(--space-24);
        list-style: none;
        padding: 0;

        a {
            color: var(--text-muted);
            transition: color 0.2s;

            &:hover {
                color: var(--text-primary);
            }
        }

        @include mobile {
            display: none;
        }
    }
    .menu-button,
    .menu-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        color: var(--text-primary);
        background: none;
        border: 0;
        cursor: pointer;
    }

    .menu-button {
        display: none;

        @include mobile {
            display: flex;
        }
    }

    .mobile-menu {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        margin: 0;
        padding: var(--space-24);
        border: 0;
        background: var(--bg-base);
        color: var(--text-primary);

        &[open] {
            display: flex;
            flex-direction: column;
            gap: var(--space-48);
        }

        &::backdrop {
            background: transparent;
        }
    }

    .mobile-menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        margin: 0;
        padding: 0;
        list-style: none;

        a {
            color: var(--text-primary);

            &:hover {
                color: var(--accent-default);
            }
        }
    }

    :global(body:has(.mobile-menu[open])) {
        overflow: hidden;
    }
</style>
