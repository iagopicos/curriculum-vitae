{
    "name": "cv-web",
    "compatibility_date": "2026-09-30",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "routes": [
        {
            "pattern": "iagopicos.dev",
            "custom_domain": true
        }
    ],
    "env": {
        "staging": {
            "name": "cv-web-staging",
            "workers_dev": true,
            "routes": [],
            "assets": {
                "directory": "./dist",
                "not_found_handling": "404-page"
            }
        }
    }
}
